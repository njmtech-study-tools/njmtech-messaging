{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "njm-messaging",
  "account_id": "243cad123070985195befb89ac8a02a5",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "INBOX", "class_name": "UserInbox" },
      { "name": "FILES", "class_name": "FileBlob" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserInbox"] },
    // Encrypted attachments live in Durable Objects instead of R2 (R2 needs a paid plan).
    { "tag": "v2", "new_sqlite_classes": ["FileBlob"] }
  ],
  // The PWA, served from the same origin as the API (build it first: pnpm --filter @njm/client build).
  // Static files are matched first; everything else (/api/*) reaches the Worker. The client uses hash
  // routing, so no SPA fallback is needed.
  "assets": { "directory": "../client/dist" },
  // Replace the ids below with the output of:
  //   wrangler d1 create njm-messaging
  //   wrangler kv namespace create KV
  "d1_databases": [
    { "binding": "DB", "database_name": "njm-messaging", "database_id": "adeeb755-daac-4966-9942-c34a47e588a3", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "9c14b75190124a4eb8ef5004379b6c22" }],
  // Clears attachment target rows older than 24h, and inbox mail older than 24h.
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "EMAIL_FROM": "Ephemeral <noreply@njmtech.co.za>",
    "VAPID_SUBJECT": "https://github.com/njmtech-study-tools/njmtech-messaging",
    "DEV_OTP_ECHO": "0",
    // Disposable inboxes are inbox+<tag>@njmtech.co.za, delivered by apps/mail-relay.
    "INBOX_DOMAIN": "njmtech.co.za",
    "INBOX_LOCAL": "inbox"
  }
  // Secrets (wrangler secret put …): JWT_SECRET, RESEND_API_KEY,
  // VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, FCM_SERVICE_ACCOUNT, INBOUND_EMAIL_SECRET
}
